{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevEnv Doctor",
  "version": "0.3.1",
  "identifier": "com.txfai.devenvdoctor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DevEnv Doctor",
        "width": 1000,
        "height": 720,
        "minWidth": 780,
        "minHeight": 520,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
